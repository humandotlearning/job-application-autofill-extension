+    answer: String(record.answer ?? '').slice(0, REWRITE_MAX_RECORD_CHARS),
+    sensitivity: sanitizeRewriteText(record.sensitivity).slice(0, REWRITE_MAX_RECORD_CHARS),
+  };
+}
